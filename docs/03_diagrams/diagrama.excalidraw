      "roundness": null,
      "seed": 8259,
      "version": 1,
      "versionNonce": 141032,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793850000000,
      "link": null,
      "locked": false,
      "text": "A. Preparação do Catálogo (naturezadespesa.csv)\n• 1.560 registros oficiais da SEFA-PR (1.223 códigos)\n• ~72.308 tokens totais (inviável colocar no prompt)\n• Construção do documento semântico por linha:\n  [codigo] descricao | Título: titulo | Detalhe: detalhe\n• Normalização léxica: minúsculas, remoção de\n  acentos (unaccent) e limpeza de stopwords.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A. Preparação do Catálogo (naturezadespesa.csv)\n• 1.560 registros oficiais da SEFA-PR (1.223 códigos)\n• ~72.308 tokens totais (inviável colocar no prompt)\n• Construção do documento semântico por linha:\n  [codigo] descricao | Título: titulo | Detalhe: detalhe\n• Normalização léxica: minúsculas, remoção de\n  acentos (unaccent) e limpeza de stopwords.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b13"
    },
    {
      "id": "rect_emb_2",
      "type": "rectangle",
      "x": 910,
      "y": 2635,
      "width": 540,
      "height": 255,
