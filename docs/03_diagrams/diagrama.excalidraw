      "versionNonce": 549778823,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "arr_srv_1",
          "type": "arrow"
        }
      ],
      "updated": 1793849529415,
      "link": null,
      "locked": false,
      "text": "A. Servidor Home Lab (Ambiente Isolado CPU-Only)\n• CPU: Intel Xeon E5-2640 v2 (8C/16T @ 2.0GHz, AVX)\n• RAM: 8 GB DDR3 (1333 MHz) + 8 GB Swap NVMe\n• GPU: GeForce 210 (Sem CUDA ➔ 100% CPU-Bound)\n• Docker Compose (Rede lab-network):\n  - ollama: 4096M RAM | 6.0 CPUs\n  - n8n: 1024M RAM | 2.0 CPUs\n  - postgres:16-alpine: 512M RAM | 1.0 CPU\n• Monitoramento: Prometheus + cAdvisor + Grafana",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A. Servidor Home Lab (Ambiente Isolado CPU-Only)\n• CPU: Intel Xeon E5-2640 v2 (8C/16T @ 2.0GHz, AVX)\n• RAM: 8 GB DDR3 (1333 MHz) + 8 GB Swap NVMe\n• GPU: GeForce 210 (Sem CUDA ➔ 100% CPU-Bound)\n• Docker Compose (Rede lab-network):\n  - ollama: 4096M RAM | 6.0 CPUs\n  - n8n: 1024M RAM | 2.0 CPUs\n  - postgres:16-alpine: 512M RAM | 1.0 CPU\n• Monitoramento: Prometheus + cAdvisor + Grafana",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b03"
    },
    {
