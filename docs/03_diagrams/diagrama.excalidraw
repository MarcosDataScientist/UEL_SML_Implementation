    {
      "id": "txt_feito_gains",
      "type": "text",
      "x": 741.2385288823427,
      "y": 1539.7203808000513,
      "width": 1342.402587890625,
      "height": 87.5,
      "angle": 0,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
