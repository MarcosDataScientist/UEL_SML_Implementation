    {
      "id": "txt_emb_2",
      "type": "text",
      "x": 929.7771294105581,
      "y": 2652.22004944274,
      "width": 403.4095458984375,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_emb_2"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 8407,
      "version": 69,
      "versionNonce": 193770334,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793850033442,
      "link": null,
      "locked": false,
      "text": "B. Modelos de Embedding Aplicados (CPU-Only)\n• 1º Denso Neural (pgvector / Sentence-Transformers):\n         paraphrase-multilingual-MiniLM-L12-v2 \n(384 dim, L2-normalizado, especializado em Português)\n\n• 2º Léxico-Semântico Leve (Notebook / CPU Zero-GPU):\n    TF-IDF Sublinear (1-2 n-grams + char_wb 3-5 radicais) \n                                    + \n       TruncatedSVD (LSA 128 dim) + Normalizer(L2).",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "B. Modelos de Embedding Aplicados (CPU-Only)\n• 1º Denso Neural (pgvector / Sentence-Transformers):\n         paraphrase-multilingual-MiniLM-L12-v2 \n(384 dim, L2-normalizado, especializado em Português)\n\n• 2º Léxico-Semântico Leve (Notebook / CPU Zero-GPU):\n    TF-IDF Sublinear (1-2 n-grams + char_wb 3-5 radicais) \n                                    + \n       TruncatedSVD (LSA 128 dim) + Normalizer(L2).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b15"
    },
    {
      "id": "rect_emb_3",
      "type": "rectangle",
      "x": 1520.2200494427398,
