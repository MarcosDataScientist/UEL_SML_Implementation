# ==============================================================================
# Ambiente de Testes SLM - Home Lab (UEL / LABGEP)
# ==============================================================================

# Ollama Inference Engine
OLLAMA_PORT=11434
DEFAULT_SLM_MODEL=llama3.2:1b

# PostgreSQL Database (com pg_trgm e unaccent)
POSTGRES_PORT=5432
POSTGRES_DB=orcamento_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# pgvector sidecar (semantic search)
# The host port is only for psql/debugging. n8n reaches pgvector:5432.
PGVECTOR_PORT=5434
PGVECTOR_DB=natureza_vectors
PGVECTOR_USER=natureza
PGVECTOR_PASSWORD=natureza
# PGVECTOR_DB/USER/PASSWORD must match semantic_search/credentials/pgvector.json.
# EMBED_MODEL/EMBED_DIM control the index; rebuild with `make semantic-ingest`
# after changing either value.
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024
EMBED_BATCH_SIZE=32

# n8n Orchestrator
N8N_PORT=5678
N8N_ENCRYPTION_KEY=homelab-slm-encryption-key-uel-2026
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
